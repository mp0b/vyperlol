# ─────────────────────────────────────────────────────────────────────────────
#  Vyper.lol — Environment template
#  Copy to `.env` and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Vyper
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth — session/token signing secret. Generate with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-long-random-secret
# Legacy alias, accepted as a fallback if AUTH_SECRET is unset.
NEXTAUTH_SECRET=

# Comma-separated emails granted OWNER on sign-up (bootstrap the first admin).
ADMIN_EMAILS=

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# For pooled providers (e.g. Neon/Supabase) set DIRECT_DATABASE_URL for migrations.
DATABASE_URL=postgresql://vyper:vyper@localhost:5433/vyper?schema=public
DIRECT_DATABASE_URL=

# ── Cache & rate limiting (optional; falls back to in-memory) ─────────────────
# RATE_LIMIT_DRIVER: memory | redis   CACHE_DRIVER: memory | redis
RATE_LIMIT_DRIVER=memory
CACHE_DRIVER=memory
REDIS_URL=

# ── File storage ─────────────────────────────────────────────────────────────
# STORAGE_DRIVER: local | s3
STORAGE_DRIVER=local
# Local driver writes here and serves via /i/[key]. Kept out of git.
LOCAL_STORAGE_DIR=./.storage
UPLOAD_MAX_MB=25

# S3 / R2 / MinIO (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
# Public base URL that maps to the bucket (CDN or bucket website endpoint).
S3_PUBLIC_URL=
# Optional dedicated CDN host for optimized image delivery.
NEXT_PUBLIC_CDN_URL=

# ── Email (optional; falls back to console driver in development) ─────────────
# EMAIL_DRIVER: console | smtp
EMAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vyper <no-reply@vyper.lol>"

# ── OAuth providers (optional; buttons hide when unset) ───────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Feature flags (comma-separated overrides; DB flags take precedence) ───────
# e.g. marketplace,custom-domains
ENABLED_FEATURES=
