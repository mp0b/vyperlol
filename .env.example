# ─────────────────────────────────────────────────────────────────────────────
#  Vyper.lol — Fichier d'environnement modèle (Template)
#  Copie ce fichier sous le nom `.env` et remplis les vraies valeurs.
#  Ne commit JAMAIS le fichier `.env` contenant tes vrais secrets !
# ─────────────────────────────────────────────────────────────────────────────

# ── Configuration de l'Application ───────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Vyper
# L'URL publique de ton site (ex: https://vyper.lol ou http://72.61.192.44:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Authentification & Sécurité ──────────────────────────────────────────────
# Génère un secret robuste de 32 caractères minimum (ex: openssl rand -base64 48)
AUTH_SECRET=VNe9DeAdxnXtNbQWZilg4FIL8Deprr9B5rbVfImKhjDQ8NNO6hcEo5HWvok=

# Emails des fondateurs/admins (séparés par une virgule). Ils auront le rôle OWNER.
ADMIN_EMAILS=brucker.zebulon@gmail.com

# ── Base de Données (PostgreSQL) ─────────────────────────────────────────────
# Format standard : postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Si tu as utilisé le script setup_vps.py, cela ressemblera à :
DATABASE_URL=postgresql://projectvyper-dev:Pr0jectVyp3r_Fr3kySk1b1d1S1gma_1%232%233%23@localhost:5432/projectvyper-db?schema=public

# Pour les hébergeurs "Serverless" comme Neon/Supabase, utilise cette ligne pour les migrations :
DIRECT_DATABASE_URL=

# ── Stockage des Médias (Images & Vidéos) ────────────────────────────────────
# STORAGE_DRIVER peut être "local" ou "s3"
STORAGE_DRIVER=local
# Dossier de stockage local (gardé hors du système Git)
LOCAL_STORAGE_DIR=./.storage
# Limite d'upload par fichier (en Mégaoctets). 50MB est idéal pour les vidéos de fond.
UPLOAD_MAX_MB=250

# (Optionnel) S3 / Cloudflare R2 / AWS (Si STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PUBLIC_URL=
NEXT_PUBLIC_CDN_URL=

# ── Authentification OAuth (Boutons Google & Discord) ────────────────────────
# Laisse vide tant que l'intégration affiche "Coming Soon"
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# (Optionnel) GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Envoi d'Emails ───────────────────────────────────────────────────────────
# EMAIL_DRIVER: console (pour dev) | smtp (pour prod)
EMAIL_DRIVER=console
SMTP_HOST=smtp.ton-domaine.com
SMTP_PORT=587
SMTP_USER=contact@vyper.lol
SMTP_PASS=
SMTP_FROM="Vyper <no-reply@vyper.lol>"

# ── Cache & Rate Limiting (Anti-Spam / Anti-DDoS) ────────────────────────────
# RATE_LIMIT_DRIVER: memory | redis
RATE_LIMIT_DRIVER=memory
CACHE_DRIVER=memory
REDIS_URL=

# ── Fonctionnalités Expérimentales ───────────────────────────────────────────
# Liste séparée par des virgules (ex: marketplace, custom-domains)
ENABLED_FEATURES=custom-domains
