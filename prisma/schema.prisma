// ─────────────────────────────────────────────────────────────────────────────
//  Vyper.lol — Prisma schema (PostgreSQL)
//  IDs: cuid • timestamps everywhere • soft-delete where it matters • FKs with
//  explicit cascade rules • indexes tuned for the hottest read paths (public
//  profile lookups by username, ordered child collections, analytics ranges).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  MODERATOR
  ADMIN
  OWNER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum ProfileVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
  PASSWORD
}

enum SectionType {
  ABOUT
  SOCIALS
  LINKS
  PROJECTS
  GALLERY
  MUSIC
  GAMES
  ANIME
  MOVIES
  SKILLS
  CUSTOM_TEXT
  WIDGETS
  DISCORD
  GITHUB
  YOUTUBE
  TWITCH
  SPOTIFY
  STEAM
}

enum LinkVisibility {
  PUBLIC
  AUTHENTICATED
  SCHEDULED
  HIDDEN
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum GalleryLayout {
  GRID
  MASONRY
  CAROUSEL
}

enum WidgetType {
  DISCORD
  GITHUB
  YOUTUBE
  SPOTIFY
  TWITCH
  STEAM
  ROBLOX
  COUNTDOWN
  CLOCK
  VISITOR_COUNT
  PROFILE_VIEWS
  LATEST_PROJECT
  CUSTOM_HTML
}

enum BadgeType {
  VERIFIED
  FOUNDER
  EARLY_USER
  DEVELOPER
  CREATOR
  STAFF
  SUPPORTER
  CUSTOM
}

enum AnalyticsEventType {
  VIEW
  LINK_CLICK
  SOCIAL_CLICK
  WIDGET_INTERACT
  PROJECT_VIEW
  SHARE
}

enum NotificationType {
  NEW_FOLLOWER
  BADGE_GRANTED
  MENTION
  SECURITY
  ACCOUNT
  SYSTEM
}

enum ReportTargetType {
  PROFILE
  LINK
  MEDIA
  USER
  PROJECT
}

enum ReportReason {
  SPAM
  ABUSE
  IMPERSONATION
  NSFW
  ILLEGAL
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ModActionType {
  WARN
  HIDE_PROFILE
  DISABLE_PROFILE
  REMOVE_CONTENT
  SUSPEND
  BAN
  UNBAN
  RESTORE
}

enum DomainSslStatus {
  PENDING
  ACTIVE
  ERROR
}

enum MarketplaceItemType {
  THEME
  WALLPAPER
  WIDGET
  PRESET
  TEMPLATE
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

// ── Identity & auth ──────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  passwordHash  String?
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  displayName   String?
  avatarUrl     String?
  locale        String     @default("en")
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  profiles          Profile[]
  sessions          Session[]
  oauthAccounts     OAuthAccount[]
  apiKeys           APIKey[]
  webhooks          Webhook[]
  badges            UserBadge[]        @relation("UserBadges")
  grantedBadges     UserBadge[]        @relation("BadgeGrantedBy")
  notifications     Notification[]
  assets            Asset[]
  reportsMade       Report[]           @relation("ReportsMade")
  reportsHandled    Report[]           @relation("ReportsHandled")
  moderationActions ModerationAction[] @relation("ModeratorActions")
  auditLogs         AuditLog[]
  following         Follow[]           @relation("Follower")
  marketplaceItems  MarketplaceItem[]
  purchases         MarketplacePurchase[]
  emailTokens       EmailVerificationToken[]
  passwordTokens    PasswordResetToken[]

  @@index([status])
  @@index([createdAt])
}

model Session {
  id          String   @id // sha256(token) — the raw token lives only in the cookie
  userId      String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())
  ipHash      String?
  userAgent   String?
  country     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  username          String?
  email             String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model EmailVerificationToken {
  id          String   @id @default(cuid())
  userId      String
  hashedToken String   @unique
  email       String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  hashedToken String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model APIKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  hashedKey  String    @unique
  prefix     String
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Profiles ─────────────────────────────────────────────────────────────────

model Profile {
  id           String            @id @default(cuid())
  userId       String
  username     String            @unique // normalized lowercase; the vyper.lol/<username> slug
  displayName  String?
  bio          String?
  location     String?
  statusText   String?
  statusEmoji  String?
  pronouns     String?
  occupation   String?
  avatarUrl    String?
  bannerUrl    String?
  tags         String[]          @default([])
  visibility   ProfileVisibility @default(PUBLIC)
  passwordHash String? // for PASSWORD visibility
  isPublished  Boolean           @default(false)
  isDefault    Boolean           @default(false)

  // SEO overrides
  seoTitle       String?
  seoDescription String?
  seoImageUrl    String?
  faviconUrl     String?

  // Denormalized counters (kept fresh on write; source of truth is the event tables)
  viewCount     Int @default(0)
  followerCount Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme         ProfileTheme?
  settings      ProfileSettings?
  sections      ProfileSection[]
  socialLinks   SocialLink[]
  customLinks   CustomLink[]
  projects      Project[]
  widgets       Widget[]
  galleries     Gallery[]
  musicTracks   MusicTrack[]
  aliases       Alias[]
  customDomains CustomDomain[]
  views         ProfileView[]
  events        AnalyticsEvent[]
  linkClicks    LinkClick[]
  followers     Follow[]         @relation("FollowingProfile")

  @@index([userId])
  @@index([isPublished, visibility])
  @@index([viewCount])
  @@index([createdAt])
}

model ProfileTheme {
  id        String   @id @default(cuid())
  profileId String   @unique
  preset    String?
  config    Json // serialized ThemeConfig (background, colors, typography, profileCard, links, effects)
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProfileSettings {
  id                String  @id @default(cuid())
  profileId         String  @unique
  showViews         Boolean @default(true)
  showBadges        Boolean @default(true)
  showFollowerCount Boolean @default(true)
  animationsEnabled Boolean @default(true)
  nsfw              Boolean @default(false)
  config            Json    @default("{}") // intro screen, cursor, audio autoplay policy, effects toggles…

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProfileSection {
  id        String      @id @default(cuid())
  profileId String
  type      SectionType
  title     String?
  position  Int         @default(0)
  visible   Boolean     @default(true)
  config    Json        @default("{}")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, position])
}

model SocialLink {
  id        String   @id @default(cuid())
  profileId String
  provider  String // key from the social provider registry
  username  String?
  url       String
  label     String?
  position  Int      @default(0)
  visible   Boolean  @default(true)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, position])
}

model CustomLink {
  id             String         @id @default(cuid())
  profileId      String
  title          String
  description    String?
  url            String
  icon           String?
  imageUrl       String?
  style          Json           @default("{}") // color, background, border, hover/click animation…
  visibility     LinkVisibility @default(PUBLIC)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  position       Int            @default(0)
  clicks         Int            @default(0)
  uniqueClicks   Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  profile     Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  clickEvents LinkClick[]

  @@index([profileId, position])
}

model LinkClick {
  id        String   @id @default(cuid())
  linkId    String
  profileId String
  country   String?
  device    String?
  referrer  String?
  visitorHash String?
  isUnique  Boolean  @default(false)
  createdAt DateTime @default(now())

  link    CustomLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  profile Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([linkId, createdAt])
  @@index([profileId, createdAt])
}

model Project {
  id           String        @id @default(cuid())
  profileId    String
  slug         String
  title        String
  description  String?
  icon         String?
  coverUrl     String?
  technologies String[]      @default([])
  url          String?
  githubUrl    String?
  demoUrl      String?
  status       ProjectStatus @default(COMPLETED)
  featured     Boolean       @default(false)
  date         DateTime?
  position     Int           @default(0)
  visible      Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  profile Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  media   ProjectMedia[]

  @@unique([profileId, slug])
  @@index([profileId, position])
}

model ProjectMedia {
  id        String    @id @default(cuid())
  projectId String
  type      MediaType @default(IMAGE)
  url       String
  thumbnailUrl String?
  caption   String?
  position  Int       @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
}

model Widget {
  id        String     @id @default(cuid())
  profileId String
  type      WidgetType
  config    Json       @default("{}")
  position  Int        @default(0)
  visible   Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, position])
}

model Gallery {
  id        String        @id @default(cuid())
  profileId String
  title     String?
  layout    GalleryLayout @default(GRID)
  position  Int           @default(0)
  visible   Boolean       @default(true)
  createdAt DateTime      @default(now())

  profile Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  items   GalleryItem[]

  @@index([profileId, position])
}

model GalleryItem {
  id        String    @id @default(cuid())
  galleryId String
  type      MediaType @default(IMAGE)
  url       String
  thumbnailUrl String?
  caption   String?
  position  Int       @default(0)

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId, position])
}

model MusicTrack {
  id        String   @id @default(cuid())
  profileId String
  title     String
  artist    String?
  coverUrl  String?
  audioUrl  String
  duration  Int?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, position])
}

// ── Media host ───────────────────────────────────────────────────────────────

model Asset {
  id           String    @id @default(cuid())
  key          String    @unique // storage key + /i/<key> public slug
  userId       String
  type         MediaType @default(IMAGE)
  mimeType     String
  ext          String
  sizeBytes    Int
  width        Int?
  height       Int?
  blurhash     String?
  originalName String?
  url          String
  thumbnailUrl String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ── Routing: aliases & custom domains ────────────────────────────────────────

model Alias {
  id        String   @id @default(cuid())
  alias     String   @unique // normalized lowercase
  profileId String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model CustomDomain {
  id                String          @id @default(cuid())
  domain            String          @unique
  profileId         String
  verified          Boolean         @default(false)
  verificationToken String
  verifiedAt        DateTime?
  sslStatus         DomainSslStatus @default(PENDING)
  createdAt         DateTime        @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

// ── Analytics ────────────────────────────────────────────────────────────────

model ProfileView {
  id          String   @id @default(cuid())
  profileId   String
  visitorHash String
  country     String?
  device      String?
  os          String?
  browser     String?
  referrer    String?
  createdAt   DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([profileId, visitorHash, createdAt])
}

model AnalyticsEvent {
  id        String             @id @default(cuid())
  profileId String
  type      AnalyticsEventType
  targetId  String?
  country   String?
  device    String?
  os        String?
  browser   String?
  referrer  String?
  metadata  Json?
  createdAt DateTime           @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, type, createdAt])
}

// ── Social graph ─────────────────────────────────────────────────────────────

model Follow {
  id                String   @id @default(cuid())
  followerId        String
  followingProfileId String
  createdAt         DateTime @default(now())

  follower         User    @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingProfile Profile @relation("FollowingProfile", fields: [followingProfileId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingProfileId])
  @@index([followingProfileId])
}

// ── Badges ───────────────────────────────────────────────────────────────────

model Badge {
  id          String    @id @default(cuid())
  key         String    @unique
  type        BadgeType @default(CUSTOM)
  name        String
  description String?
  icon        String // lucide icon name or asset url
  color       String?
  glow        Boolean   @default(false)
  order       Int       @default(0)
  isPublic    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  userBadges UserBadge[]
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  badgeId     String
  grantedById String?
  visible     Boolean  @default(true)
  order       Int?
  grantedAt   DateTime @default(now())

  user      User  @relation("UserBadges", fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("BadgeGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, badgeId])
  @@index([userId])
}

// ── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

// ── Moderation ───────────────────────────────────────────────────────────────

model Report {
  id          String           @id @default(cuid())
  reporterId  String?
  targetType  ReportTargetType
  targetId    String
  profileId   String?
  reason      ReportReason     @default(OTHER)
  details     String?
  status      ReportStatus     @default(OPEN)
  handledById String?
  resolvedAt  DateTime?
  createdAt   DateTime         @default(now())

  reporter  User? @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: SetNull)
  handledBy User? @relation("ReportsHandled", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model ModerationAction {
  id          String           @id @default(cuid())
  moderatorId String
  targetType  ReportTargetType
  targetId    String
  action      ModActionType
  reason      String?
  metadata    Json?
  createdAt   DateTime         @default(now())

  moderator User @relation("ModeratorActions", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([createdAt])
}

// ── Developer platform: API keys handled above, webhooks here ────────────────

model Webhook {
  id        String   @id @default(cuid())
  userId    String
  url       String
  secret    String
  events    String[] @default([])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([userId])
}

model WebhookDelivery {
  id           String                @id @default(cuid())
  webhookId    String
  event        String
  payload      Json
  status       WebhookDeliveryStatus @default(PENDING)
  attempts     Int                   @default(0)
  responseCode Int?
  createdAt    DateTime              @default(now())
  deliveredAt  DateTime?

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
}

// ── Marketplace ──────────────────────────────────────────────────────────────

model MarketplaceItem {
  id          String              @id @default(cuid())
  authorId    String
  type        MarketplaceItemType
  title       String
  description String?
  previewUrl  String?
  data        Json
  priceCents  Int                 @default(0)
  published   Boolean             @default(false)
  downloads   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  author    User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  purchases MarketplacePurchase[]

  @@index([type, published])
}

model MarketplacePurchase {
  id         String   @id @default(cuid())
  itemId     String
  userId     String
  priceCents Int      @default(0)
  createdAt  DateTime @default(now())

  item MarketplaceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
}

// ── Platform config & audit ──────────────────────────────────────────────────

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  rollout     Json?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipHash     String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}
